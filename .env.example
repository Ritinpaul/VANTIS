# ─────────────────────────────────────────────────
#  VANTIS — Environment Variables
#  Copy this to .env and fill in the values.
# ─────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────
DATABASE_URL=postgresql://vantis:vantis@localhost:5432/vantis

# ── Nebius Token Factory & Nemotron (Primary Provider) ─────────
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEMOTRON_MODEL=nvidia/Llama-3_1-Nemotron-70B-Instruct-HF
PRIMARY_REASONING_PROVIDER=nemotron

# ── Gemini API (Secondary / Fallback Provider) ────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FAST_MODEL=gemini-2.5-flash          # understand, decompose, eval, swarm
GEMINI_SMART_MODEL=gemini-2.5-pro           # specify_specialist, analyze_failure, plan_repair

# ── App Config ────────────────────────────────────
ENVIRONMENT=development                      # development | production
DEMO_MODE=true                               # enables DEMO_RESPONSES fallback
LOG_LEVEL=INFO

# ── Demo Timing (seconds) ─────────────────────────
DEMO_ACT1_DELAY=0.5
DEMO_ACT2_DELAY=0.5
DEMO_ACT3_DELAY=0.8
DEMO_ACT4_DELAY=0.5

# ── CORS ──────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://vantis.vercel.app

# ── Frontend (set in apps/web/.env.local) ─────────
NEXT_PUBLIC_API_URL=http://localhost:8000
